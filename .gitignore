# --- Datasets (too big for GitHub; download separately) ---------------
WAID/
*.zip

# --- Generated by the experiments (reproducible from code) ------------
degraded/
results/frames/
results/identified/

# --- Training runs ----------------------------------------------------
# Ignore everything in runs/ EXCEPT the final trained weights, which are
# small enough (~6 MB) to be worth sharing.
runs/*
!runs/waid_baseline/
runs/waid_baseline/*
!runs/waid_baseline/weights/
runs/waid_baseline/weights/*
!runs/waid_baseline/weights/best.pt

# --- Python environments ----------------------------------------------
venv/
env/
.venv/
__pycache__/
*.py[cod]

# --- Auto-downloaded model checkpoints --------------------------------
yolov8n.pt
yolo11n.pt

# --- OS / editor junk --------------------------------------------------
.DS_Store
Thumbs.db
